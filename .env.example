# Copy to .env. These values are for a local learning/demo setup.
DB_URL=jdbc:mysql://localhost:3306/campusexchange
DB_USER=campus
DB_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
# Generate: openssl rand -hex 32. Never commit a real .env.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
HOLD_MINUTES=15
DEMO_DATA=true
